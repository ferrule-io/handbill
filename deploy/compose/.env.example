# Copy to .env and fill in. Every variable is documented in
# docs/design.md#configuration.

# Required. Generate each with: openssl rand -hex 32
SECRET_KEY=
POSTGRES_PASSWORD=

# Image tag. Pin a release (e.g. 0.1.2) for production; see
# https://github.com/ferrule-io/handbill/releases
HANDBILL_VERSION=latest

# Where the app and the sites live. The defaults work on your own machine
# (browsers resolve *.localhost to 127.0.0.1). In production use https and
# your own domains, e.g.
#   APP_ORIGIN=https://handbill.example.com
#   SITES_DOMAIN=example-sites.com
APP_ORIGIN=http://dash.localhost:8080
SITES_DOMAIN=sites.localhost

# Host address the container port is published on. Keep it on loopback when a
# reverse proxy on the same machine terminates TLS.
HANDBILL_BIND=127.0.0.1:8080

# Behind a reverse proxy: the proxy's address(es), so rate limits see real
# client IPs. Docker's default bridge network is 172.16.0.0/12.
TRUSTED_PROXIES=

# Optional: email notifications (invites, verification). Off when empty.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=

# Optional: "Continue with Google". Off when empty. Redirect URI:
#   <APP_ORIGIN>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Dynamic Client Registration for MCP clients that do not support
# Client ID Metadata Documents. Off by default.
OAUTH_DCR_ENABLED=

# Optional: size limits (defaults 512MiB per file, 1GiB per site, 512MiB per
# archive). MAX_FILE_SIZE must not exceed the other two.
MAX_FILE_SIZE=
MAX_SITE_SIZE=
MAX_ARCHIVE_SIZE=
